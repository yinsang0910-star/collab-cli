{
  "name": "collab-cli",
  "version": "1.4.2",
  "description": "Universal collaboration protocol + CLI for multi-agent LLM teams",
  "type": "module",
  "homepage": "https://github.com/yinsang0910-star/collab-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinsang0910-star/collab-cli.git"
  },
  "bugs": {
    "url": "https://github.com/yinsang0910-star/collab-cli/issues"
  },
  "keywords": [
    "collaboration",
    "multi-agent",
    "llm",
    "protocol",
    "mcp",
    "claude",
    "reasonix"
  ],
  "bin": {
    "collab": "bin/collab.js"
  },
  "files": [
    "bin/",
    "src/commands/!(*.test).js",
    "src/core/!(*.test).js",
    "src/node/!(*.test).js",
    "src/utils/!(*.test).js",
    "src/templates/",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "README.ko.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test src/**/*.test.js"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
